# Base URL of the Tarkov API that receives article payloads.
TARKOV_BASE_URL=http://127.0.0.1:8080

# Optional: HTTP bind address for scuttle_crab.
SCUTTLE_BIND_ADDR=127.0.0.1:3000

# Optional: path appended to TARKOV_BASE_URL for article delivery.
TARKOV_INGEST_PATH=/v1/articles

# Optional: request timeout in seconds for Tarkov delivery.
TARKOV_TIMEOUT_SECS=15

# Optional: max number of company search articles to fetch.
SCUTTLE_COMPANY_ARTICLE_LIMIT=10
